{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LanDrop",
  "version": "0.1.0",
  "identifier": "dev.landrop.desktop",
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "LanDrop",
    "shortDescription": "Fast local file transfer for Windows LANs.",
    "longDescription": "LanDrop sends files and folders directly between Windows PCs on the local network without SMB shares, accounts, or cloud services.",
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "LanDrop"
      }
    }
  },
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "beforeBuildCommand": "npm.cmd run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LanDrop",
        "width": 1460,
        "height": 980,
        "minWidth": 1140,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
